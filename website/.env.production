# Used automatically by `npm run build` (production builds only).
# Not a secret — this is the same public API URL already baked into the
# published Flutter app bundle, so it is committed on purpose (see the
# !.env.production exception in .gitignore) to keep builds reproducible.
NEXT_PUBLIC_API_BASE_URL=https://mbbsabroadconsultancy-production.up.railway.app/api

# Where this site actually serves from. Drives canonical tags, sitemap and
# structured data — change this ONE line when a real domain goes live
# (e.g. https://www.sreeconsultancy.com), then push to redeploy.
NEXT_PUBLIC_SITE_URL=https://sreeconsultancy-site.sreeeduu.workers.dev
