# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# The backend reads these as environment variables.

# ── Database (local dev defaults match docker-compose.yml) ──
DB_URL=jdbc:postgresql://localhost:5432/medicabroad
DB_USERNAME=medic
DB_PASSWORD=medic

# ── Server ──
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5555

# ── WhatsApp Cloud API ──
# Keep WHATSAPP_ENABLED=false until the token is rotated + template approved;
# while false, notifications are logged instead of sent.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v22.0
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_NAME=new_application
WHATSAPP_LANGUAGE_CODE=en
# ADMIN_WHATSAPP_TO=919786193822

# ── Document storage ──
# "local" (default) writes uploads to a local folder — fine for dev.
# "r2" uploads to Cloudflare R2 — set this to r2 and fill in the values below
# before going to production, so documents survive redeploys/restarts.
STORAGE_TYPE=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=medic-abroad-documents

# ── Admin panel login ──
ADMIN_USERNAME=admin
# Production: set a BCrypt hash here (preferred). Leave ADMIN_PASSWORD blank then.
# ADMIN_PASSWORD_HASH=$2a$10$....
# Local dev convenience: plaintext password (ignored if ADMIN_PASSWORD_HASH is set).
ADMIN_PASSWORD=changeme123
# Must be >= 32 characters. Generate a random one for production.
ADMIN_JWT_SECRET=dev-only-change-me-please-min-32-characters!!
ADMIN_SESSION_HOURS=12
